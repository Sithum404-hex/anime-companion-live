# Template for environment variables.
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# SECURITY MODEL:
#   - Variables WITHOUT the VITE_ prefix are SERVER-SIDE ONLY. They are read
#     inside server functions and are never bundled into client JavaScript.
#   - Variables WITH the VITE_ prefix ARE shipped to the browser. Only put
#     public, non-secret values there.

# ── Server-side secrets ────────────────────────────────────────────────────

# AI chat + Screen Vision (OpenRouter). Read only in server functions.
OPENROUTER_API_KEY=sk-or-your-key-here

# Voice output / TTS (Typecast) — used in ALL modes (Chat, Screen Vision, Live).
# Use the non-VITE name; the server reads TYPECAST_API_KEY.
TYPECAST_API_KEY=your-typecast-key-here

# Gemini Live mode (realtime voice + camera). SERVER-SIDE ONLY:
# used exclusively by the createLiveToken server function to mint short-lived
# ephemeral tokens for the Live WebSocket. The long-lived key must never reach
# the browser — do NOT rename it with a VITE_ prefix. Configure it in
# `.env.local` for local development and as a Cloudflare Secret (Settings ->
# Environment variables) in production. Live mode uses this existing
# ephemeral-token architecture: the browser only ever receives the
# short-lived token minted by createLiveToken. If it is missing, the
# Live panel shows "GEMINI_API_KEY not set on server." while Chat and Screen
# Vision keep working.
GEMINI_API_KEY=your-gemini-api-key-here

# ── Client-side (public) ───────────────────────────────────────────────────

# Supabase — the anon key is public by design; row-level security protects data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional ───────────────────────────────────────────────────────────────

# OpenRouter attribution header (defaults to http://localhost:3000).
#SITE_URL=https://your-site.pages.dev
